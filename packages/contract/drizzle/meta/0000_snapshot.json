          "value": "\"notes\".\"notes\".\"first_night\" = date_trunc(\"notes\".\"notes\".\"date_precision\", \"notes\".\"notes\".\"first_night\"::timestamp)::date\n        and (\"notes\".\"notes\".\"last_night\" is null\n          or \"notes\".\"notes\".\"last_night\" = date_trunc(\"notes\".\"notes\".\"date_precision\", \"notes\".\"notes\".\"last_night\"::timestamp)::date)"
