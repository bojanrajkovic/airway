# Synthetic settings for `pnpm dev`. Put your own overrides in .env, which git ignores.
# docs/configuration.md describes every key.
DATABASE_URL=postgres://airway:airway@127.0.0.1:54318/airway
AIRWAY_READER_DATABASE_URL=postgres://airway_reader:airway@127.0.0.1:54318/airway
AIRWAY_PATIENT_NAME=Sample Patient
AIRWAY_PATIENT_BIRTH_DATE=2015-03-14
AIRWAY_ADULT_RULES_FROM_13=false
AIRWAY_CLOCK_OFFSETS=[{"from":"2025-01-01","utcOffset":"-05:00"}]
AIRWAY_TIME_ZONE=America/Chicago
AIRWAY_UI_HOST=localhost
AIRWAY_MCP_HOST=localhost
AIRWAY_JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json
AIRWAY_MIRROR_PATH=/tmp/airway-mirror
PORT=3000
LOG_LEVEL=debug
