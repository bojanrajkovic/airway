{
  "name": "airway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "for project in . packages/*/; do [ -d \"$project\" ] || continue; tsc --project \"$project\" || exit 1; done",
    "lint": "oxlint --ignore-pattern tests/fixtures/lint/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "check": "pnpm run --no-bail \"/^(typecheck|lint|format:check|test)$/\"",
    "db:up": "podman run --detach --rm --name airway-postgres --publish 127.0.0.1:54318:5432 --env POSTGRES_PASSWORD=airway docker.io/library/postgres:18@sha256:bd5dfa494a5a259704365813dbfa5fa6b3e69be7348d43b547f540c730478583",
    "db:down": "podman stop airway-postgres"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-plugin-eslint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
