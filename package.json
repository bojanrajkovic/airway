{
  "name": "airway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "scripts/typecheck.sh",
    "lint": "oxlint --ignore-pattern tests/fixtures/lint/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "check": "pnpm run --no-bail \"/^(typecheck|lint|format:check|test)$/\"",
    "db:up": "scripts/db-up.sh",
    "db:down": "podman stop airway-postgres"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-plugin-eslint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
