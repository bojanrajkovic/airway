{
  "name": "airway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "pnpm run --no-bail \"/^typecheck:/\"",
    "typecheck:root": "tsc --project .",
    "typecheck:packages": "pnpm --recursive --no-bail typecheck",
    "lint": "oxlint --ignore-pattern tests/fixtures/lint/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "check": "pnpm run --no-bail \"/^(typecheck|lint|format:check|test)$/\"",
    "db:up": "scripts/db.sh up",
    "db:down": "scripts/db.sh down"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "catalog:",
    "@tsconfig/node": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-plugin-eslint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
