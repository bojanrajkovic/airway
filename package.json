{
  "name": "airway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "typecheck": "pnpm run --no-bail \"/^typecheck:/\"",
    "typecheck:root": "tsc --project .",
    "typecheck:packages": "pnpm --recursive --no-bail typecheck",
    "lint": "oxlint --ignore-pattern '**/fixtures/lint/**'",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run --project unit --project telemetry",
    "test:db": "vitest run --project db",
    "test:browser": "vitest run --project browser",
    "test:image": "vitest run --project image",
    "check": "pnpm run --no-bail \"/^(typecheck|lint|format:check|test)$/\"",
    "db:up": "scripts/db.sh up",
    "db:down": "scripts/db.sh down",
    "build": "pnpm --recursive build"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "catalog:",
    "@tsconfig/node": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-plugin-eslint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pino-pretty": "catalog:",
    "playwright": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
